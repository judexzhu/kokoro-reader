{
  "manifest_version": 3,
  "name": "Kokoro Reader",
  "version": "0.1.0",
  "description": "Reads web pages aloud with Kokoro TTS. The voice model runs on your device; nothing is sent anywhere.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "offscreen", "scripting", "activeTab", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kokoro Reader",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "commands": {
    "toggle-reading": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Play or pause" },
    "stop-reading": { "suggested_key": { "default": "Alt+Shift+X" }, "description": "Stop reading" },
    "prev-sentence": { "suggested_key": { "default": "Alt+J" }, "description": "Previous sentence" },
    "next-sentence": { "suggested_key": { "default": "Alt+K" }, "description": "Next sentence" }
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
